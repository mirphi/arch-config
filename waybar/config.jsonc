{
    "include": [
      "~/.config/waybar/modules.jsonc"
    ],

    "position": "bottom",
    "margin-top" : 1.9,
    "margin-left": 20,
    "margin-right": 20,
    "height" : 28,

    "modules-left": [
      "hyprland/workspaces"
    ],

    "modules-center": [
      "hyprland/window"
    ],
    
    "modules-right": [
      "hyprland/language",
      "pulseaudio",
      "battery",
      "network",
      "clock",
      "tray"
    ]
}